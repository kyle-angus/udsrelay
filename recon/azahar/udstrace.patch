+// UDS recon tracing for the 3DS Local Wireless Relay project.
+// Emits one "UDSTRACE" line per traced IPC request, reply, wake-up, event signal and payload.
+// Lines are parsed by the project's udstrace tool; keep the key=value format stable.
+
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <span>
+#include <string>
+#include <string_view>
+#include <fmt/format.h>
+#include "common/common_types.h"
+
+namespace Common::UdsTrace {
+
+/// Wall-clock microseconds since the Unix epoch, so logs from two instances merge exactly.
+inline u64 WallMicros() {
+    using namespace std::chrono;
+    return static_cast<u64>(
+        duration_cast<microseconds>(system_clock::now().time_since_epoch()).count());
+}
+
+/// Ports to trace, from UDSTRACE_PORTS (comma-separated). Empty string disables tracing.
+inline bool PortEnabled(std::string_view port) {
+    static const std::string ports = [] {
+        const char* env = std::getenv("UDSTRACE_PORTS");
+        return std::string(env ? env : "nwm::UDS,ndm:u,ac:u,ac:i");
+    }();
+    std::string_view rest = ports;
+    while (!rest.empty()) {
+        const auto comma = rest.find(',');
+        const auto item = rest.substr(0, comma);
+        if (item == port) {
+            return true;
+        }
+        if (comma == std::string_view::npos) {
+            break;
+        }
+        rest.remove_prefix(comma + 1);
+    }
+    return false;
+}
+
+inline bool UdsEnabled() {
+    return PortEnabled("nwm::UDS");
+}
+
+/// Max bytes of send/recv payload hex to log, from UDSTRACE_PAYLOAD_MAX (default 512, -1 = all).
+/// Azahar stops writing a log at 100 MiB, so full payloads shorten how long a session can run.
+inline size_t PayloadMax() {
+    static const size_t max = [] {
+        const char* env = std::getenv("UDSTRACE_PAYLOAD_MAX");
+        if (env == nullptr || *env == '\0') {
+            return static_cast<size_t>(512);
+        }
+        const long value = std::strtol(env, nullptr, 10);
+        return value < 0 ? static_cast<size_t>(-1) : static_cast<size_t>(value);
+    }();
+    return max;
+}
+
+inline std::string Hex(std::span<const u8> data) {
+    static constexpr char digits[] = "0123456789abcdef";
+    std::string out;
+    out.reserve(data.size() * 2);
+    for (const u8 b : data) {
+        out.push_back(digits[b >> 4]);
+        out.push_back(digits[b & 0xF]);
+    }
+    return out;
+}
+
+inline std::string Words(const u32* words, int count) {
+    std::string out;
+    for (int i = 0; i < count; ++i) {
+        if (i != 0) {
+            out.push_back(',');
+        }
+        out += fmt::format("{:#010x}", words[i]);
+    }
+    return out;
+}
+
+/// Number of words in an IPC message including the header.
+inline int MessageWords(u32 header) {
+    return 1 + static_cast<int>(header & 0x3F) + static_cast<int>((header >> 6) & 0x3F);
+}
+
+} // namespace Common::UdsTrace
