+/// Logs a payload for the udstrace tool. tag is one of netinfo, passphrase, appdata, send, recv.
+static void TraceBlob(u16 command_id, std::string_view tag, std::span<const u8> data,
+                      std::string_view extra = {}) {
+    if (!Common::UdsTrace::UdsEnabled()) {
+        return;
+    }
+    // size is the full payload length; hex may be truncated (see UDSTRACE_PAYLOAD_MAX).
+    const bool is_payload = tag == "send" || tag == "recv";
+    const auto logged = is_payload ? data.first(std::min(data.size(), Common::UdsTrace::PayloadMax()))
+                                   : data;
+    LOG_INFO(Service, "UDSTRACE v=1 kind=blob wall={} port=nwm::UDS cmd={:#06x} tag={}{}{} size={} hex={}",
+             Common::UdsTrace::WallMicros(), command_id, tag, extra.empty() ? "" : " ", extra,
+             data.size(), Common::UdsTrace::Hex(logged));
+}
