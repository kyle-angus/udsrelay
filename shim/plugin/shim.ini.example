# Copy to sdmc:/udsrelay/shim.ini to change the defaults.

# Services to intercept and log. Add ac:u to see whether the game checks the
# Wi-Fi connection during local play (an open question in the design doc).
ports = nwm::UDS, ndm:u

# Bytes of each send/recv/beacon payload to log; -1 logs whole payloads.
payload_max = 512

# passthrough (default): forward nwm::UDS to the real NWM and log it (Phase 2).
# relay: answer nwm::UDS in the shim and carry local play over the relay (Phase 4). Needs relay
# and lobby below, and turns fake_ndm on.
# mode = relay

# The relay, and the lobby key shared with it and the other console. In passthrough mode, setting
# both runs the Phase 4 relay check instead: a HELLO every 5 s, logged next to Wi-Fi and NDM state.
# relay = 192.168.1.20:28300
# lobby = <the key from the relay's lobbies file>

# Answer ndm:u's EnterExclusiveState/LeaveExclusiveState/GetExclusiveState in the shim instead
# of passing them to NDM, so infrastructure Wi-Fi stays up while the game plays "locally".
# The real local wireless (nwm::UDS passthrough) may then fail; that is expected in this check.
# fake_ndm = 1
